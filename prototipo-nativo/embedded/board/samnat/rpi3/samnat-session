#!/bin/sh
set -eu

export HOME=/data/home
export SAMNAT_KIOSK=1
export SAMNAT_DISPLAY_PROFILE=mpi3501
export QT_QPA_PLATFORM=linuxfb
export QT_QPA_FONTDIR=/usr/share/fonts/dejavu
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_SCALE_FACTOR=1
export QT_ENABLE_HIGHDPI_SCALING=0
export QT_DEVICE_PIXEL_RATIO=1
export LD_LIBRARY_PATH="/opt/samnat-synth/lib/audio:${LD_LIBRARY_PATH:-}"

FRAMEBUFFER=
for entry in /sys/class/graphics/fb*; do
	[ -r "$entry/name" ] || continue
	name=$(cat "$entry/name")
	case "$name" in
		*ili9486*|*ILI9486*|*piscreen*) FRAMEBUFFER="/dev/${entry##*/}"; break ;;
	esac
done
if [ -z "$FRAMEBUFFER" ]; then
	for entry in /sys/class/graphics/fb*; do
		[ -r "$entry/virtual_size" ] || continue
		size=$(cat "$entry/virtual_size")
		case "$size" in 480,320|320,480) FRAMEBUFFER="/dev/${entry##*/}"; break ;; esac
	done
fi
[ -n "$FRAMEBUFFER" ] || FRAMEBUFFER=/dev/fb0
export QT_QPA_PLATFORM="linuxfb:fb=$FRAMEBUFFER"

for entry in /sys/class/input/event*; do
	[ -r "$entry/device/name" ] || continue
	name=$(cat "$entry/device/name")
	case "$name" in
		*ADS7846*|*ads7846*|*XPT2046*|*xpt2046*)
			event_node="/dev/input/${entry##*/}"
			export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS="$event_node${SAMNAT_TOUCH_PARAMETERS:+:$SAMNAT_TOUCH_PARAMETERS}"
			break
			;;
	esac
done

MOUSE_EVENT=$(cat /run/samnat-pointer/mouse-event 2>/dev/null || true)
if [ -n "$MOUSE_EVENT" ]; then
	export QT_QPA_EVDEV_MOUSE_PARAMETERS="$MOUSE_EVENT"
else
	unset QT_QPA_EVDEV_MOUSE_PARAMETERS || true
fi

mkdir -p "$HOME/.samnat-synth/soundfonts"
chmod 0755 /data /data/home "$HOME/.samnat-synth" "$HOME/.samnat-synth/soundfonts"
/usr/local/bin/samnat-audio-init || true
exec /opt/samnat-synth/AppRun
