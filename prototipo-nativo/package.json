{
  "name": "samnat-synth-native-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Native SamNat Synth prototype with eight parts, MIDI and local scenes.",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "qode src/index.js",
    "pack:init": "nodegui-packer --init SamnatSynthNative",
    "prepare:linux": "node scripts/prepare-linux.cjs",
    "pack:linux": "npm run prepare:linux && node scripts/pack-linux.cjs"
  },
  "dependencies": {
    "@nodegui/nodegui": "0.58.0",
    "midi": "^2.0.0"
  },
  "devDependencies": {
    "@nodegui/packer": "1.5.0"
  }
}
