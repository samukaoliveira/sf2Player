# Raspberry Pi 3B+: SPI0 drives the MPI3501 LCD and XPT2046 touchscreen.
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y

# MPI3501 LCD: ILI9486 over SPI, exposed through DRM/KMS.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_TINYDRM_ILI9486=y

# Resistive touchscreen: XPT2046 uses the Linux ADS7846-compatible driver.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ADS7846=y
