#!/bin/sh
set -eu

APP_ROOT=/opt/samnat-synth
QT_MULTIARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH)
QT_PLUGIN_ROOT="/usr/lib/$QT_MULTIARCH/qt6/plugins"

export HOME=/home/samnat
export SAMNAT_KIOSK=1
export SAMNAT_DISPLAY_PROFILE=mpi3501
export QT_QPA_PLATFORM_PLUGIN_PATH="$QT_PLUGIN_ROOT/platforms"
export QT_PLUGIN_PATH="$QT_PLUGIN_ROOT"
export QT_QPA_FONTDIR=/usr/share/fonts/truetype/dejavu
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_SCALE_FACTOR=1
export QT_ENABLE_HIGHDPI_SCALING=0
export QT_DEVICE_PIXEL_RATIO=1

FRAMEBUFFER=${SAMNAT_FRAMEBUFFER:-}
for framebuffer in /sys/class/graphics/fb*; do
	[ -z "$FRAMEBUFFER" ] || break
	[ -r "$framebuffer/name" ] || continue
	name=$(cat "$framebuffer/name")
	case "$name" in
		*ili9486*|*ILI9486*|*piscreen*) FRAMEBUFFER="/dev/${framebuffer##*/}"; break ;;
	esac
done

# Some DRM framebuffer names are generic. Prefer a device reporting the
# panel's landscape or portrait dimensions, then fall back to fb0 for a Pi
# booting without HDMI. SAMNAT_FRAMEBUFFER can override this when needed.
if [ -z "$FRAMEBUFFER" ]; then
	for framebuffer in /sys/class/graphics/fb*; do
		[ -r "$framebuffer/virtual_size" ] || continue
		size=$(cat "$framebuffer/virtual_size")
		case "$size" in
			480,320|320,480)
				FRAMEBUFFER="/dev/${framebuffer##*/}"
				break
				;;
		esac
	done
fi
[ -n "$FRAMEBUFFER" ] || FRAMEBUFFER=/dev/fb0
[ -c "$FRAMEBUFFER" ] || {
	echo "Framebuffer $FRAMEBUFFER não existe. Confira /dev/fb* ou defina SAMNAT_FRAMEBUFFER." >&2
	exit 1
}
export QT_QPA_PLATFORM="linuxfb:fb=$FRAMEBUFFER"

for event in /sys/class/input/event*; do
	[ -r "$event/device/name" ] || continue
	name=$(cat "$event/device/name")
	case "$name" in
		*ADS7846*|*ads7846*|*XPT2046*|*xpt2046*)
			event_node="/dev/input/${event##*/}"
			export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS="$event_node${SAMNAT_TOUCH_PARAMETERS:+:$SAMNAT_TOUCH_PARAMETERS}"
			break
			;;
	esac
done

export PATH="$APP_ROOT/node_modules/@nodegui/qode/binaries:$PATH"
cd "$APP_ROOT"
exec "$APP_ROOT/node_modules/@nodegui/qode/binaries/qode" "$APP_ROOT/src/index.js"
